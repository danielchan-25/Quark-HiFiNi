[Unit]
Description=Quark-HiFiNi verified private state backup
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUTF8=1
Environment=TZ=Asia/Shanghai
UMask=0077
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/backup.sh --execute
TimeoutStartSec=20min
