[Unit]
Description=Quark-HiFiNi combined daily Feishu summary
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUTF8=1
Environment=TZ=Asia/Shanghai
UMask=0077
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/monitor.sh run summary
TimeoutStartSec=5min
