[Unit]
Description=Quark-HiFiNi combined daily Feishu summary
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUTF8=1
Environment=TZ=Asia/Shanghai
UMask=0077
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/run.sh daily-summary --send
TimeoutStartSec=5min
