[Unit]
Description=Quark-HiFiNi upload and publication
After=graphical-session.target network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUTF8=1
Environment=TZ=Asia/Shanghai
UMask=0077
ExecStart=/usr/bin/bash @PROJECT_ROOT@/scripts/monitor.sh run daily
TimeoutStartSec=6h
