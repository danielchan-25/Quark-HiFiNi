# 1. 飞书告警通知（可选；未配置时告警入库，dry-run 始终不发送）
FEISHU_WEBHOOK=
FEISHU_SECRET=

# 2. HiFiNi 账号密码（浏览器会话失效时用于重新登录）
HIFINI_USERNAME=
HIFINI_PASSWORD=

# 3. Chrome CDP 地址（可选，默认 http://127.0.0.1:9501）
HIFINI_CDP_URL=http://127.0.0.1:9501

# 4. 本机工具路径（可选；根据实际安装位置覆盖）
# QUARK_SKILL_DIR=C:\Users\admin\.agents\skills\quarkclouddrive
# GIT_BASH=D:\Git\bin\bash.exe

# 5. TypeSafe 影子判断：仅记录建议，不影响发布；off 关闭
TYPESAFE_MODE=shadow
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT=15
TYPESAFE_MAX_CALLS=6
