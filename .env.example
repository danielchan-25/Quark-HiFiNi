# Copy to .env locally. Never commit credentials or authorization directories.
HIFINI_CDP_URL=http://127.0.0.1:9501
HIFINI_USERNAME=
HIFINI_PASSWORD=

# Official Quark Skill must be installed and authorized on this machine.
# Default location: ~/.codex/skills/quarkclouddrive
# QUARK_SKILL_DIR=/home/YOUR_USER/.codex/skills/quarkclouddrive
# BASH_PATH=/usr/bin/bash
# CURL_BIN=/usr/bin/curl
# FFPROBE_BIN=/usr/bin/ffprobe
# BROWSER_BIN=/usr/bin/google-chrome
# Optional for environments without an interactive desktop, after login is configured:
# BROWSER_HEADLESS=1

FEISHU_WEBHOOK=
FEISHU_SECRET=

# Local or cloud API with the Chat Completions compatible protocol.
# A server root, a /v1 base, or the complete /chat/completions URL is accepted.
# Example: http://127.0.0.1:11434/v1 or https://YOUR_GATEWAY/v1
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional: off or shadow. Shadow reviews evidence; deterministic rules control writes.
AI_MODE=shadow
AI_TIMEOUT=60
AI_MAX_CALLS=6
AI_MAX_TOKENS=4096
AI_JSON_MODE=1

# Legacy TypeSafe is used only when all three AI_* connection fields are empty.
TYPESAFE_MODE=off
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT=15
TYPESAFE_MAX_CALLS=6
# Storage: enable mysql only after migrate_mysql.py has verified the import.
STORAGE_BACKEND=sqlite
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=quark
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TABLE_PREFIX=hifini
